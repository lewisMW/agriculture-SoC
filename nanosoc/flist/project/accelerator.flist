//-----------------------------------------------------------------------------
// Accelerator Subsystem Filelist
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
// Abstract : This file contains a list of files and directories related to
//            your accelerator. PLEASE MODIFY!!!
//-----------------------------------------------------------------------------

// DESIGN_TOP accelerator_subsystem

// ============= Verilog library extensions ===========
+libext+.v+.vlib

// =============    Accelerator Module search path    =============

// ! Point this to your Accelerator RTL
$(ACCELERATOR_DIR)/AHB
$(ACCELERATOR_DIR)/Dummy/dummy_adc.v
$(ACCELERATOR_DIR)/Dummy/dummy_amux.v
$(ACCELERATOR_DIR)/Dummy/dummy_pll.v
$(ACCELERATOR_DIR)/FIFO/fifo_apb_adc.v
// List the FSM/RTC design modules EXPLICITLY, not as directory entries. The
// flist tool (filelist_compile.py) silently drops bare directory paths in
// vfiles mode — only `-y <dir>`, `+incdir+`, and explicit `.v` files emit
// sources. And `-y` here blindly globs EVERY module-bearing file in the dir,
// so pointing it at FSM/ or RTC/ would also pull in their per-block
// testbenches and legacy revisions (wrapper_control_2_tb, tb_rtc_control,
// rtc_control, ...) as extra top-levels. Matches the standalone makefile.
$(ACCELERATOR_DIR)/FSM/wrapper_control_2.v
$(ACCELERATOR_DIR)/RTC/rtc_control_2.v
$(ACCELERATOR_DIR)/Wrapper/adc_apb_wrapper_rev2.v

// PL031 RTC IP — rtc_control_2.v instantiates the PL031 `Rtc` module. Same IP the
// standalone SoC uses; it lives under ARM_IP_LIBRARY_PATH, not ACCELERATOR_DIR.
// The module sources are flat in .../rtc_pl031/verilog/rtl_source (siblings:
// netlist/, makefile). `-y` globs that dir for module-bearing files (mirrors the
// standalone makefile's `find $(rtc_ip) -name '*.v'`), and *_defs.v includes
// carry no modules, so they're skipped as sources and picked up via +incdir+.
-y $(ARM_IP_LIBRARY_PATH)/PL031/PL031-r1p3-00rel0/PL031-BU-00000-r1p3-00rel0/PL031_VC/rtc_pl031/verilog/rtl_source
+incdir+$(ARM_IP_LIBRARY_PATH)/PL031/PL031-r1p3-00rel0/PL031-BU-00000-r1p3-00rel0/PL031_VC/rtc_pl031/verilog/rtl_source

// ! Point this to your Wrapper RTL
// (Not Needed, we are not using wrappers like this)
//$(SOCLABS_PROJECT_DIR)/wrapper/src/soclabs_ahb_aes128_ctrl.v

// ! Point this to your Subsystem RTL
$(SOCLABS_PROJECT_DIR)/system/src/accelerator_subsystem.v
