$(SOCLABS_PROJECT_DIR)/system/verif/cov/nsc_bus_cov.sv
$(SOCLABS_PROJECT_DIR)/system/verif/cov/nsc_reset_cov.sv
$(SOCLABS_PROJECT_DIR)/system/verif/cov/nsc_cpu_cov.sv
$(SOCLABS_PROJECT_DIR)/system/verif/cov/nsc_sysio_cov.sv
$(SOCLABS_PROJECT_DIR)/system/verif/cov/nsc_debug_pins_cov.sv
$(SOCLABS_PROJECT_DIR)/system/verif/cov/nsc_bind_sensing.sv
$(SOCLABS_PROJECT_DIR)/system/verif/cov/nsc_bind_system.sv
