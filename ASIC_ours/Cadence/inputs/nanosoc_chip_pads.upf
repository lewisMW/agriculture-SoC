set_design_top nanosoc_chip_pads

#######################################
# Create Power Domains
######################################
# TODO I should not be mixing one domain/supply! One to one here (except for SS_IO_Q)
create_power_domain PD_TOP -include_scope -supply {SS_TOP} -supply {SS_IO} -supply {SS_ANALOG}

set all_io_cell_names [get_db [get_cells uPAD*] .name]
#lappend all_io_cell_names P0
#lappend all_io_cell_names P1
set all_io_elems uPAD_NRST_I/XRES_H_N

create_power_domain PD_IO -supply {SS_TOP} -supply {SS_IO} -supply {SS_SWITCH} -supply {SS_HIB} -supply {SS_IO_Q} -supply {SS_ANALOG} -elements $all_io_cell_names
create_power_domain PD_ANALOG -supply {SS_ANALOG} -elements {}

#######################################
# Create Supply Ports
#######################################
# Top Port Supplies

set all_supplies [dict create \
  VDD     [dict create supply_cell_name "uPAD_VDD_*" domain "PD_TOP" supply_pin_name "VCCD" connect_net_name "VCCD" voltage 1.8] \
  VSS     [dict create supply_cell_name "uPAD_VSS_*" domain "PD_TOP" supply_pin_name "VSSD" connect_net_name "VSSD" voltage 0] \
  VDDIO   [dict create supply_cell_name "uPAD_VDDIO_*" domain "PD_IO" supply_pin_name "VDDIO" connect_net_name "VDDIO" voltage 3.3] \
  VSSIO   [dict create supply_cell_name "uPAD_VSSIO_*" domain "PD_IO" supply_pin_name "VSSIO" connect_net_name "VSSIO" voltage 0] \
  VDDIO_Q [dict create supply_cell_name "uPAD_VDDIOQ_*" domain "PD_IO" supply_pin_name "VDDIO" connect_net_name "VDDIO_Q" voltage 3.3] \
  VSSIO_Q [dict create supply_cell_name "uPAD_VSSIOQ_*" domain "PD_IO" supply_pin_name "VSSIO" connect_net_name "VSSIO_Q" voltage 0] \
  VDDA    [dict create supply_cell_name "uPAD_VDDA_*" domain "PD_ANALOG" supply_pin_name "VDDA" connect_net_name "VDDA" voltage 1.8] \
  VSSA    [dict create supply_cell_name "uPAD_VSSA_*" domain "PD_ANALOG" supply_pin_name "VSSA" connect_net_name "VSSA" voltage 0] \
]

# auxillary power pins, that don't have power supplies
# in this flow VSWITCH connected to VDDIO, VCCHIB to VCCD
set all_supplies_nets [dict merge $all_supplies [dict create \
  VSWITCH [dict create domain "PD_IO" connect_net_name "VSWITCH" voltage 3.3] \
  VCCHIB  [dict create domain "PD_TOP" connect_net_name "VCCHIB" voltage 1.8] \
]]

dict map {supply_name supply_args} $all_supplies_nets {
  # 1: connect the supplies to their verilog equivalent ports
  # TODO is this correct?
  create_supply_port $supply_name -direction inout 
  connect_supply_net $supply_name -ports $supply_name
  #create_supply_net $supply_name -domain "PD_TOP"
  create_supply_net $supply_name -domain [dict get $supply_args domain]
}

set_domain_supply_net PD_TOP    -primary_power_net VDD -primary_ground_net VSS
set_domain_supply_net PD_IO     -primary_power_net VDDIO -primary_ground_net VSSIO
set_domain_supply_net PD_ANALOG -primary_power_net VDDA -primary_ground_net VSSA


#######################################
# Create Supply Sets
######################################
create_supply_set PD_TOP.SS_TOP   -function {power VDD} -function {ground VSS} -update
#create_supply_set PD_TOP.SS_IO    -function {power VDDIO} -function {ground VSSIO} -update
#create_supply_set PD_TOP.SS_IO_Q  -function {power VDDIO_Q} -function {ground VSSIO_Q} -update
#create_supply_set PD_TOP.SS_ANALOG  -function {power VDDA} -function {ground VSSA} -update
create_supply_set PD_IO.SS_IO     -function {power VDDIO} -function {ground VSSIO} -update
# not completely needed, but here to avoid ambiguity
create_supply_set PD_IO.SS_SWITCH   -function {power VSWITCH} -function {ground VSSIO_Q} -update
create_supply_set PD_IO.SS_HIB   -function {power VCCHIB} -function {ground VSS} -update
create_supply_set PD_IO.SS_IO_Q   -function {power VDDIO_Q} -function {ground VSSIO_Q} -update
create_supply_set PD_ANALOG.SS_ANALOG  -function {power VDDA} -function {ground VSSA} -update

# associate_supply_set <existing supply> -handle <the other name>
associate_supply_set PD_TOP.SS_TOP     -handle PD_IO.SS_TOP
associate_supply_set PD_IO.SS_IO     -handle PD_TOP.SS_IO
associate_supply_set PD_ANALOG.SS_ANALOG -handle PD_TOP.SS_ANALOG
associate_supply_set PD_TOP.SS_ANALOG  -handle PD_IO.SS_ANALOG

# associate particular pins of cells to a supply set.
proc set_port_domains {port_obj supply_set port_or_pin} {
  set port_name [get_db $port_obj .name]
  set direction [get_db $port_obj .direction]
  if {($direction == "in" && $port_or_pin == "pin") || ($direction == "out" && $port_or_pin == "port")} {
    set_port_attributes -ports $port_name -receiver_supply $supply_set
  } elseif {($direction == "out" && $port_or_pin == "pin") || ($direction == "in" && $port_or_pin == "port")} {
    set_port_attributes -ports $port_name -driver_supply $supply_set
  } elseif {$direction == "inout"} {
    set_port_attributes -ports $port_name -receiver_supply $supply_set -driver_supply $supply_set
  } else {
    throw {UNSUPPORTED} "port $port_name with type ${direction} is not supported, only in, out, inout"
  }
}

# This works!!!!
# TODO I can't do this with the analog ports but is otherwise okay
set all_ports [get_db [get_ports] .name]
lmap port $all_ports {
  set_port_domains [get_ports $port] PD_TOP.SS_IO "port"
}
# taken from https://skywater-pdk.readthedocs.io/en/main/contents/libraries/sky130_fd_io/docs/user_guide.html#sky130-fd-io-gpiov2-additional-features
# some other pad cells also share the same pin mapping. 
# Thus ASSUMPTION: the power domain for the same named pin across sky130 io cells are the same.
# Note: ENABLE_VSWITCH_H using VDDIO domain to make upf happy, as well as because vswitch connected to vddio anyway
set gpio_supply_set_mapping [dict create \
  ENABLE_H           PD_IO.SS_IO \
  HLD_H_N            PD_IO.SS_IO \
  SLOW               PD_IO.SS_TOP \
  VTRIP_SEL          PD_IO.SS_TOP \
  INP_DIS            PD_IO.SS_TOP \
  DM[0]              PD_IO.SS_TOP \
  DM[1]              PD_IO.SS_TOP \
  DM[2]              PD_IO.SS_TOP \
  HLD_OVR            PD_IO.SS_TOP \
  OE_N               PD_IO.SS_HIB \
  OUT                PD_IO.SS_HIB \
  IN                 PD_IO.SS_HIB \
  IN_H               PD_IO.SS_IO \
  ENABLE_INP_H       PD_IO.SS_IO \
  IB_MODE_SEL        PD_IO.SS_TOP \
  ENABLE_VDDIO       PD_IO.SS_TOP \
  ENABLE_VDDA_H      PD_IO.SS_ANALOG \
  ANALOG_EN          PD_IO.SS_TOP \
  ANALOG_SEL         PD_IO.SS_TOP \
  ANALOG_POL         PD_IO.SS_TOP \
  #ENABLE_VSWITCH_H   PD_IO.SS_SWITCH \
  ENABLE_VSWITCH_H   PD_IO.SS_IO \
  AMUXBUS_A          PD_IO.SS_ANALOG \
  AMUXBUS_B          PD_IO.SS_ANALOG \
  TIE_HI_ESD         PD_IO.SS_IO \  
  TIE_LO_ESD         PD_IO.SS_IO \
  PAD_A_ESD_0_H      PD_IO.SS_IO \
  PAD_A_ESD_1_H      PD_IO.SS_IO \
  PAD_A_NOESD_H      PD_IO.SS_IO \
]
# TODO the other pins like for XRES
foreach pin_name [get_db [get_pins uPAD*/*] .name] {
  set pin_obj [get_pins $pin_name]
  set pin_basename [get_db $pin_obj .base_name]
  if {[dict exists $gpio_supply_set_mapping $pin_basename]} {
    set domain [dict get $gpio_supply_set_mapping $pin_basename]
    set_port_domains $pin_obj $domain "pin"
  }
}

# to make upf happy, I have to explicity define power supplies for every cell. 
# the generated rams forgot to do that.
set all_sram_instances [list u_nanosoc_chip/u_system/u_ss_cpu/u_region_dmem_0/u_dmem_0/u_sram/genblk1.u_sram u_nanosoc_chip/u_system/u_ss_cpu/u_region_imem_0/u_imem_0/u_sram/genblk1.u_sram u_nanosoc_chip/u_system/u_ss_expansion/u_region_expram_h/u_expram_h/u_sram/genblk1.u_sram u_nanosoc_chip/u_system/u_ss_expansion/u_region_expram_l/u_expram_l/u_sram/genblk1.u_sram]
lmap sram_cell $all_sram_instances {
  set cell_pins [get_db [get_pins $sram_cell/*] .name]
  lmap cell_pin $cell_pins {
    set_port_domains [get_pins $cell_pin] PD_TOP.SS_TOP "pin"
  }
}

# need to do the same for some IO pins too.
foreach supply_cell_pad_pin [get_db [get_pins uPAD_*/*_PAD] .name] { # power IO cell pins
  set_port_attributes -ports $supply_cell_pad_pin -receiver_supply PD_IO.SS_IO -driver_supply PD_IO.SS_IO
}
# TODO check how the analog parts are wired
foreach gpio_pad_pin [get_db [get_pins uPAD_*/PAD] .name] { # all pads
  set_port_domains [get_pins $gpio_pad_pin] PD_IO.SS_IO "pin"
}



#######################################
# Add Power States
#######################################
dict map {supply_name supply_args} $all_supplies_nets {
  set voltage_typ [dict get $supply_args voltage]
  set voltage_slow [expr {$voltage_typ * 0.9}]
  set voltage_fast [expr {$voltage_typ * 1.1}]
  add_port_state $supply_name -state [list ON_SLOW $voltage_slow]
  add_port_state $supply_name -state [list ON_TYP  $voltage_typ ]
  add_port_state $supply_name -state [list ON_FAST $voltage_fast]
}

