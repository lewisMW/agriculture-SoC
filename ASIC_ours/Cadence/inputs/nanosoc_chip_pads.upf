set_design_top nanosoc_chip_pads

#######################################
# Create Power Domains
######################################
create_power_domain PD_TOP -include_scope -supply {SS_TOP} -supply {SS_IO} -supply {SS_IO_Q} -supply {SS_ANALOG}

set all_io_cell_names [get_db [get_cells uPAD*] .name]
#lappend all_io_cell_names P0
#lappend all_io_cell_names P1
set all_io_elems uPAD_NRST_I/XRES_H_N

create_power_domain PD_IO -supply {SS_IO} -supply {SS_IO_Q} -elements {}
create_power_domain PD_ANALOG -supply {SS_ANALOG} -elements {}

#create_power_domain PD_MEM -elements {u_nanosoc_chip/u_system/u_ss_cpu/u_region_dmem_0/u_dmem_0/u_sram u_nanosoc_chip/u_system/u_ss_cpu/u_region_imem_0/u_imem_0/u_sram u_nanosoc_chip/u_system/u_ss_expansion/u_region_expram_h/u_expram_h/u_sram u_nanosoc_chip/u_system/u_ss_expansion/u_region_expram_l/u_expram_l/u_sram}

#######################################
# Create Supply Ports
#######################################
# Top Port Supplies

set all_supplies [dict create \
  VDD     [dict create supply_cell_name "uPAD_VDD_*" domain "PD_TOP" supply_pin_name "VCCD" connect_net_name "VCCD"] \
  VSS     [dict create supply_cell_name "uPAD_VSS_*" domain "PD_TOP" supply_pin_name "VSSD" connect_net_name "VSSD"] \
  VDDIO   [dict create supply_cell_name "uPAD_VDDIO_*" domain "PD_IO" supply_pin_name "VDDIO" connect_net_name "VDDIO"] \
  VSSIO   [dict create supply_cell_name "uPAD_VSSIO_*" domain "PD_IO" supply_pin_name "VSSIO" connect_net_name "VSSIO"] \
  VDDIO_Q [dict create supply_cell_name "uPAD_VDDIOQ_*" domain "PD_IO" supply_pin_name "VDDIO" connect_net_name "VDDIO_Q"] \
  VSSIO_Q [dict create supply_cell_name "uPAD_VSSIOQ_*" domain "PD_IO" supply_pin_name "VSSIO" connect_net_name "VSSIO_Q"] \
  VDDA    [dict create supply_cell_name "uPAD_VDDA_*" domain "PD_ANALOG" supply_pin_name "VDDA" connect_net_name "VDDA"] \
  VSSA    [dict create supply_cell_name "uPAD_VSSA_*" domain "PD_ANALOG" supply_pin_name "VSSA" connect_net_name "VSSA"] \
]

set_domain_supply_net PD_TOP    -primary_power_net VDD -primary_ground_net VSS
set_domain_supply_net PD_IO     -primary_power_net VDDIO -primary_ground_net VSSIO
set_domain_supply_net PD_ANALOG -primary_power_net VDDA -primary_ground_net VSSA

# auxillary power pins, that don't have power supplies
# in this flow VSWITCH connected to VDDIO, VCCHIB to VCCD
set all_supplies_nets [dict merge $all_supplies [dict create \
  VSWITCH [dict create domain "PD_IO" connect_net_name "VSWITCH"] \
  VCCHIB  [dict create domain "PD_TOP" connect_net_name "VCCHIB"] \
]]

dict map {supply_name supply_args} $all_supplies_nets {
  #create_supply_net $supply_name -domain [dict get $supply_args domain]
  create_supply_net $supply_name -domain "PD_TOP"
}  

dict map {supply_name supply_args} $all_supplies {
  # 1: connect the supplies to their verilog equivalent ports
  # TODO is this correct?
  create_supply_port $supply_name -direction inout 
  connect_supply_net $supply_name -ports $supply_name
  # 2: connect net to the power supply cells
  # this step is mainly for VDDIO_Q, VSSIO_Q, because they connect to a different pin name than their supply
  # In this case I have to connect their VDDIO/VSSIO pin to VDDIO_Q, VSSIO_Q
  set all_supply_cells_name [get_db [get_cells [dict get $supply_args supply_cell_name]] .name]
  set supply_pin_name [dict get $supply_args supply_pin_name]
  foreach supply_cell_name $all_supply_cells_name {
    set supply_pad_pin [get_db [get_pins $supply_cell_name/$supply_pin_name] .name]
    #create_supply_port $supply_pad_pin
    connect_supply_net $supply_name -ports $supply_pad_pin
  }
}

# I think the other connections should be automatic...

# after connecting supplies, connect the IO ring.
