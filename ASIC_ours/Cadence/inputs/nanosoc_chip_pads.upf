#######################################
# Create Supply Sets
######################################
create_supply_set PD_TOP.SS_TOP   -function {power VDD} -function {ground VSS} -update
create_supply_set PD_TOP.SS_IO    -function {power VDDIO} -function {ground VSSIO} -update
create_supply_set PD_TOP.SS_IO_Q  -function {power VDDIO_Q} -function {ground VSSIO_Q} -update
create_supply_set PD_TOP.SS_ANALOG  -function {power VDDA} -function {ground VSSA} -update
create_supply_set PD_IO.SS_IO     -function {power VDDIO} -function {ground VSSIO} -update
create_supply_set PD_IO.SS_IO_Q   -function {power VDDIO_Q} -function {ground VSSIO_Q} -update
create_supply_set PD_ANALOG.SS_ANALOG  -function {power VDDA} -function {ground VSSA} -update

# This is not right...
# set_port_attributes -ports {SE} -receiver_supply PD_IO.SS_IO
# Set the outside + inside to be the SS_IO domain???
set_port_attributes -ports {uPAD_NRST_I/XRES_H_N} -driver_supply_set PD_IO.SS_IO -receiver_supply_set PD_IO.SS_IO


#######################################
# Add Power States
######################################
add_port_state VDD              -state {ON_SLOW 1.62}
add_port_state VDD              -state {ON_TYP  1.80}
add_port_state VDD              -state {ON_FAST 1.98}
add_port_state VSS              -state {ON_SLOW 0.0}
add_port_state VSS              -state {ON_TYP  0.0}
add_port_state VSS              -state {ON_FAST 0.0}
add_port_state VDDIO            -state {ON_SLOW 2.97}
add_port_state VDDIO            -state {ON_TYP  3.30}
add_port_state VDDIO            -state {ON_FAST 3.63}
add_port_state VSSIO            -state {ON_SLOW 0}
add_port_state VSSIO            -state {ON_TYP  0}
add_port_state VSSIO            -state {ON_FAST 0}
add_port_state VDDIO_Q          -state {ON_SLOW 2.97}
add_port_state VDDIO_Q          -state {ON_TYP  3.30}
add_port_state VDDIO_Q          -state {ON_FAST 3.63}
add_port_state VSSIO_Q          -state {ON_SLOW 0}
add_port_state VSSIO_Q          -state {ON_TYP  0}
add_port_state VSSIO_Q          -state {ON_FAST 0}
add_port_state VDDA             -state {ON_SLOW 1.62}
add_port_state VDDA             -state {ON_TYP  1.80}
add_port_state VDDA             -state {ON_FAST 1.98}
add_port_state VSSA             -state {ON_SLOW 0.0}
add_port_state VSSA             -state {ON_TYP  0.0}
add_port_state VSSA             -state {ON_FAST 0.0}

add_power_state PD_TOP.SS_TOP         -state ON_SLOW {-supply_expr {power == `{FULL_ON, 1.62} && ground == `{FULL_ON, 0.0}}}
add_power_state PD_TOP.SS_TOP         -state ON_TYP  {-supply_expr {power == `{FULL_ON, 1.80} && ground == `{FULL_ON, 0.0}}}
add_power_state PD_TOP.SS_TOP         -state ON_FAST {-supply_expr {power == `{FULL_ON, 1.98} && ground == `{FULL_ON, 0.0}}}
add_power_state PD_IO.SS_IO           -state ON_SLOW {-supply_expr {power == `{FULL_ON, 2.97} && ground == `{FULL_ON, 0.0}}}
add_power_state PD_IO.SS_IO           -state ON_TYP  {-supply_expr {power == `{FULL_ON, 3.30} && ground == `{FULL_ON, 0.0}}}
add_power_state PD_IO.SS_IO           -state ON_FAST {-supply_expr {power == `{FULL_ON, 3.63} && ground == `{FULL_ON, 0.0}}}
add_power_state PD_IO.SS_IO_Q         -state ON_SLOW {-supply_expr {power == `{FULL_ON, 2.97} && ground == `{FULL_ON, 0.0}}}
add_power_state PD_IO.SS_IO_Q         -state ON_TYP  {-supply_expr {power == `{FULL_ON, 3.30} && ground == `{FULL_ON, 0.0}}}
add_power_state PD_IO.SS_IO_Q         -state ON_FAST {-supply_expr {power == `{FULL_ON, 3.63} && ground == `{FULL_ON, 0.0}}}
add_power_state PD_TOP.SS_ANALOG   -state ON_SLOW {-supply_expr {power == `{FULL_ON, 1.62} && ground == `{FULL_ON, 0.0}}}
add_power_state PD_TOP.SS_ANALOG   -state ON_TYP  {-supply_expr {power == `{FULL_ON, 1.80} && ground == `{FULL_ON, 0.0}}}
add_power_state PD_TOP.SS_ANALOG   -state ON_FAST {-supply_expr {power == `{FULL_ON, 1.98} && ground == `{FULL_ON, 0.0}}}

create_pst top_pst -supplies {\
    VDD \
    VSS \
    VDDIO \
    VSSIO \
    VDDIO_Q \
    VSSIO_Q \
    VDDA \
    VSSA \
}
 

add_pst_state all_on_slow -pst top_pst -state       {ON_SLOW  ON_SLOW  ON_SLOW  ON_SLOW  ON_SLOW  ON_SLOW  ON_SLOW  ON_SLOW  } 
add_pst_state all_on_typ -pst top_pst -state        {ON_TYP   ON_TYP   ON_TYP   ON_TYP   ON_TYP   ON_TYP   ON_TYP   ON_TYP   } 
add_pst_state all_on_fast -pst top_pst -state       {ON_FAST  ON_FAST  ON_FAST  ON_FAST  ON_FAST  ON_FAST  ON_FAST  ON_FAST  } 

# Add the level shifters
# TODO this is not too right - it's including too much, including some pins that are not needed...
#foreach domain [list PD_TOP PD_IO PD_ANALOG] {
