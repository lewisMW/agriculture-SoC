set_level_shifter LS_PD_TOP_GENERAL -domain PD_TOP -source PD_TOP.SS_IO -sink PD_TOP.SS_TOP
#set_level_shifter LS_PD_TOP_TO_PD_TO -domain PD_TOP -source PD_TOP.SS_TOP -sink PD_IO.SS_IO
#set_level_shifter LS_PD_IO_TO_PD_TOP -domain PD_TOP -source PD_TOP.SS_IO -sink PD_IO.SS_TOP