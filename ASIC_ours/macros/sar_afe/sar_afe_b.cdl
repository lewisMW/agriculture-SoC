************************************************************************
* Library Name: sar_adc
* Cell Name:    bootstrap_sw
* View Name:    schematic
************************************************************************

.SUBCKT sar_afe_b__bootstrap_sw en in out vdd vss
*.PININFO en:I in:I out:O vdd:B vss:B
MMs2 vss enb net30 vss nfet_01v8_lvt W=1u L=400n M=1
MMs1 net30 vdd net2 vss nfet_01v8_lvt W=1u L=400n M=1
MMs out net2 in vss nfet_01v8_lvt W=1u L=500n M=1
MM1 vbsl net2 in vss nfet_01v8_lvt W=1u L=400n M=1
MM2 vbsl enb vss vss nfet_01v8_lvt W=1u L=400n M=1
MM4 net2 enb vbsh vbsh pfet_01v8_lvt W=1u L=400n M=1
MM3 vdd net2 vbsh vbsh pfet_01v8_lvt W=1u L=400n M=1
CC4 vbsh vbsl $[cap_mim_m3__base] m=1 l=5u w=5u
CC2 vbsh vbsl $[cap_mim_m3__base] m=1 l=5u w=5u
CC1 vbsh vbsl $[cap_mim_m3__base] m=1 l=5u w=5u
CC0 vbsh vbsl $[cap_mim_m3__base] m=1 l=5u w=5u
Xinv_lvt0 en enb vdd vss / sar_afe_b__inv_lvt
.ENDS

