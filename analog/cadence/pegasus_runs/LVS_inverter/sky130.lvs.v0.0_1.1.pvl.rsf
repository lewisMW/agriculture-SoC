mergeParallel("nfet_20v0(MN)" merge
    language("
             /* File: /home/hee/cadence/lib/sky130_release_0.1.0/Sky130_LVS/sky130.lvs.v0.0_1.1.pvl 1319 */
             effective w,l,totalW,nf,m        \n
             w = sum((w * nf))       \n
             totalW = w       \n
