mergeParallel(source("lvs_reduce") M merge
    language("
             effective W,L,AD,AS,PD,PS       \n
             checkForZeroW = prod ( W )       \n
             checkForZeroL = prod ( L )       \n
             if(checkForZeroW && checkForZeroL) {      \n
               P = sum(W*L)        \n
               Q = sum(W/L)        \n
               W = sqrt(P*Q)        \n
               L = sqrt(P/Q) }       \n
             AS = sum( AS )       \n
             AD = sum( AD )       \n
             PS = sum( PS )       \n
             PD = sum( PD )       \n
             "
             )
    )
