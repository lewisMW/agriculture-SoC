<?xml version="1.0"?>
<setupdb version="7">maestro
	<active>Active Setup
		<tests>
			<test>sar_adc_sine_fft
				<tool>OCEAN</tool>
				<tooloptions>
					<option>cell
						<value>tb_sar</value>
					</option>
					<option>lib
						<value>sar_adc</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR</value>
					</option>
					<option>sim
						<value>ams</value>
					</option>
					<option>state
						<value>active</value>
					</option>
					<option>view
						<value>config</value>
					</option>
				</tooloptions>
				<vars>
					<var>fclk
						<value>1000000</value>
					</var>
					<var>Nfft
						<value>1024</value>
					</var>
					<var>M_cycles
						<value>31, 509</value>
					</var>
					<var>N_drop
						<value>2</value>
					</var>
					<var>t_start
						<value>0.0001005</value>
					</var>
					<var>vssa
						<value>0</value>
					</var>
					<var>vdda
						<value>1.8</value>
					</var>
					<var>v_cm
						<value>0.9</value>
					</var>
					<var>fin_2
						<value>0</value>
					</var>
					<var>fs
						<value>fclk/10</value>
					</var>
					<var>v_ref
						<value>vdda</value>
					</var>
					<var>fin_1
						<value>fs*M_cycles/Nfft</value>
					</var>
					<var>t_drop
						<value>N_drop/fs</value>
					</var>
					<var>t0
						<value>t_start + t_drop</value>
					</var>
					<var>t1
						<value>t0 + M_cycles/fin_1</value>
					</var>
					<var>t_sim
						<value>t_start + t_drop + (t1-t0) + 1/fs</value>
					</var>
				</vars>
			</test>
		</tests>
		<checksasserts netlist="0"></checksasserts>
		<jobpolicyname></jobpolicyname>
		<jobcontrolmode>LSCS</jobcontrolmode>
		<corners>
			<corner enabled="1">_default</corner>
		</corners>
		<sharedvarinfo></sharedvarinfo>
		<extensions>
			<extension>Parasitics
				<callback>_parSetupDBExtensionCB</callback>
				<iconvalue></iconvalue>
				<icontype></icontype>
			</extension>
		</extensions>
		<currentmode>Single Run, Sweeps and Corners</currentmode>
		<overwritehistory>0</overwritehistory>
		<incrementalsimulationoptions>
			<incrementalSimulation>0</incrementalSimulation>
		</incrementalsimulationoptions>
		<overwritehistoryname>Interactive.4</overwritehistoryname>
		<plottingoptions>
			<plottingoption>plottingmode
				<value>Replace</value>
			</plottingoption>
			<plottingoption>plottype
				<value>None</value>
			</plottingoption>
			<plottingoption>usewaveformtemplate
				<value>no</value>
			</plottingoption>
			<plottingoption>useMaestroPlottingTemplate
				<value>yes</value>
			</plottingoption>
			<plottingoption>waveformtemplate
				<value></value>
			</plottingoption>
			<plottingoption>allplottingtemplates
				<value></value>
			</plottingoption>
			<plottingoption>defaultplottingtemplate
				<value></value>
			</plottingoption>
			<plottingoption>distributedplot_enabled
				<value>no</value>
			</plottingoption>
		</plottingoptions>
	</active>
	<history>History
	</history>
</setupdb>
