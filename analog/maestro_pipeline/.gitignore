# Keep in git: the scripts, README, and for each export its summary results
#   export.txt, <test>/foms.csv, sweep_<test>.csv, sweep_<test>.png,
#   and for histogram tests pt<N>/hist.png, hist.csv, hist_info.csv
# Leave out everything else the exports hold:

# per-point raw data: regenerated by the export. (The histogram outputs in the same folders,
# hist.png, hist.csv and hist_info.csv, are kept.)
data/exports/**/pt*/samples.csv
data/exports/**/pt*/fft.csv
data/exports/**/pt*/vars.csv
# OCEAN's full log: starts with Cadence's licence banner and licence checkouts
ocean.log
# Maestro results databases (binary, ~0.5 MB each)
*.rdb
*.rdb-journal
# full waveforms, if exported with WAVEFORMS=1
vout.csv

# this machine's ssh settings (host, key)
vm_settings.local.sh

# Python / macOS clutter
__pycache__/
*.pyc
.DS_Store

# histogram.py --ideal output (regenerated)
data/ideal_hist.png
