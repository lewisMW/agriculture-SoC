    if (read and (chan1 == False)): # control channel
      sys.stdout.write(chr(data))
    if (read and (chan1 == True)):  #data channel
      print("{",chr(data),"}",sep='',end='')
#    if (verbose == True) and (read == False):  #write echo
#      print("<",f"write:{rx:012b}",">",sep='',end='\n')
  if select.select([sys.stdin], [], [], 0)[0]:
    char = sys.stdin.readline(1)  # Read exactly one character
    xiot_tx0(ord(char))
