; XIO Target driver
;       example pin numbers allocated for testbench
;       REQ1,REQ2 ideally contiguous
;       DATA[3:0] must be contiguous
;   SM0 providing status signalling
;       pin jump on REQ1 at transfer start
;       then command parsing/acknowledge and direction setup and signalling
;       and set interrupt to SM1 or SM2 depending on channel
;       poll until end of transfer
; ;   SM1, SM3 interrupt handler threads to transmit data
;       data transfer/acknowledge with autopop byte
;       poll until end of transfer
;
;
; SPDX-License-Identifier: BSD-3-Clause
;
.define public XIOT_RQ1 0
.define public XIOT_RQ2 1
.define public XIOT_ACK 2
.define public XIOT_DATA 3 // gpio base offset 4-bits [0:3]
.define public XIOT_DATAWIDTH 4 // GPIO[06:03] specifically

.program XIOTsm0
.side_set 1 opt // mapped to {XIOT_ACK}

.lang_opt python out_init     = (rp2.PIO.OUT_HIGH,rp2.PIO.OUT_HIGH,rp2.PIO.OUT_HIGH,rp2.PIO.OUT_HIGH)
.lang_opt python set_init     = (rp2.PIO.OUT_HIGH,rp2.PIO.OUT_HIGH,rp2.PIO.OUT_HIGH,rp2.PIO.OUT_HIGH)
.lang_opt python sideset_init = (rp2.PIO.OUT_HIGH)
.lang_opt python out_shiftdir = rp2.PIO.SHIFT_RIGHT
.lang_opt python in_shiftdir  = rp2.PIO.SHIFT_LEFT
.lang_opt python autopush     = True
.lang_opt python autopull     = False
.lang_opt python push_thresh  = 12
.lang_opt python pull_thresh  = 4

; XIOT status (4 bits from TXFIFO until packet starts)
; NOTE: must write 0xf to TXFIFO 0 before starting SM (no xfers)
; set jmp_pin XIOT_RQ1
; side-signals: {(opt update), DIR, ACK}
; XDATA : IN[3:0],  OUT[3:0], SET[3:0]

.wrap_target // wrap target for SM0
sm0:
    set x, 0b1111                 // default busy
    set pindirs 0b1111            // status drive on dio pins
statloop:                         // poll status flags from RXFIFO
    pull noblock                  // return X if empty
    mov x, osr                    // update flags if changed
    out pins, 4                   // drive status flags
    jmp pin command    side 0     // deassert ACK, exit status update loop if RQ1 asserted
    jmp statloop                  // otherwise keep updating
command:                          // input and parse command 
    set pindirs 0b0000 side 1 [1] // tristate, set first ACK before command
    wait 1 gpio, XIOT_RQ2     [2] // set first ACK, await REQ2 (and delay before input)
    in pins, 4                   // 4-bit command capture
    mov osr, isr       side 0    // parse using OSR, clear first ACK
    out y, 1                     // Y = cmd[0] : 0 for RX, 1 for TX
    out x, 1                     // X = cmd[1] : 0 for CON, 1 for DATA
    wait 0 gpio, XIOT_RQ2        // poll REQ2 deasserted
    jmp !y, rxdata               // 0 to branch to input data hi,lo
txdata:
    set pindirs, 0b1111          // TX so output data hi,lo
txchan:
    jmp x--, txchan1             // non zero so TX3
txchan0:                         // console TX (to STDIN)
    irq set 5                [2] // assert IRQ 4+1 to trigger SM1, wait 2 (+1)
    jmp txcapture
txchan1:                         // Data TX
    irq set 7                [2] // assert IRQ 4+3 to trigger SM3, wait 3
txcapture:                       // tx also sampled/captured
rxdata:
    nop                      [3] // delay for input data hi to stabilize
    in  pins, 4                  // capture high nibble, set 2nd ACK
    wait 1 gpio, XIOT_RQ2 side 1 [3]  // poll RQ2, delay for input data lo to stabilize
    in pins, 4                   // capture low nibble, clr 2nd ACK
    wait 0 gpio, XIOT_RQ2 side 0 // wait RQ2 low
    wait 0 gpio, XIOT_RQ1 side 1 // set third ack, wait for RQ1 low
    irq set 0                    // signal IRQ (non-blocking)
.wrap // jmp sm02

.program XIOTsm13
.side_set 1 opt // mapped to {XIOT_ACK}

.lang_opt python out_init     = (rp2.PIO.OUT_HIGH,rp2.PIO.OUT_HIGH,rp2.PIO.OUT_HIGH,rp2.PIO.OUT_HIGH)
.lang_opt python sideset_init = (rp2.PIO.OUT_HIGH)
.lang_opt python out_shiftdir = rp2.PIO.SHIFT_LEFT
.lang_opt python autopull     = True
.lang_opt python pull_thresh  = 8

//.program SM1, SM2 for data transfer channels 
.wrap_target
sm13:
//  autopull (sm1.put() before enable) TXD in in bits[31:24]
    wait 1 irq, 4 rel           // SM +1, or SM +3, and auto-ack irq
    pull noblock
txdh:
    out pins, 4   side 1        // high nibble drive, synchronous ACK assert
    wait 1 gpio, XIOT_RQ2       // wait REQ2 deasserted
txdl:
    out pins, 4   side 0        // low nibble, synchronous ACK deassert
.wrap // jmp sm13

% c-sdk {
static inline void XIOT0_program_init(PIO pio) {
    pio_sm_config cfg_sm0 = XIOT_pio_get_default_sm_config();
    pio_sm_config cfg_sm1 = XIOT_pio_get_default_sm_config();
    pio_sm_config cfg_sm3 = XIOT_pio_get_default_sm_config();

// SM0: status, command parse and set direction, Mon/RX0
    sm_config_set_in_shift(&cfg_sm0, false, true, 12); // SHL, Autopush
    sm_config_set_out_shift(&cfg_sm0, true, false, 4); // SHR, no autopull, 4 bits of status flags
    sm_config_set_in_pins(&cfg_sm0, XIOT_DATA);
    sm_config_set_out_pins(&cfg_sm0, XIOT_DATA, XIOT_DATAWIDTH);
    sm_config_set_sideset_pins(&cfg_sm0, XIOT_ACK);
    sm_config_set_sideset(&cfg_sm0, 1, true);
    sm_config_set_jmp_pin(&cfg_sm0, XIOT_RQ1);  // 
    sm_config_set_wrap(&cfg_sm0, XIOTsm0_wrap_target, XIOTsm0_wrap); // wrap from 0

// SM1: TX1, data transfer interrupt thread
    sm_config_set_out_shift(&cfg_sm1, true, false, 8); // SHR, no autopull, 8-bit data
    sm_config_set_out_pins(&cfg_sm1, XIOT_DATA, XIOT_DATAWIDTH);
    sm_config_set_sideset_pins(&cfg_sm1, XIOT_ACK);
    sm_config_set_sideset(&cfg_sm1, 1, true);
    sm_config_set_wrap(&cfg_sm1, XIOTsm13_wrap_target, XIOTsm13_wrap);

// SM3: TX3, data transfer interrupt thread
    sm_config_set_out_shift(&cfg_sm3, true, false, 8); // SHR, no autopull, 8-bit data
    sm_config_set_out_pins(&cfg_sm3, XIOT_DATA, XIOT_DATAWIDTH);
    sm_config_set_sideset_pins(&cfg_sm3, XIOT_ACK);
    sm_config_set_sideset(&cfg_sm3, 1, true);
    sm_config_set_wrap(&cfg_sm3, XIOTsm13_wrap_target, XIOTsm13_wrap);

    // Map the state machine's data pins
    // parameter to this function.
    pio_gpio_init(pio, XIOT_ACK, true);
    // Connext PIO data bus (connect PIO to the pad)
    pio_gpio_init(pio, XIOT_DATA+0);
    pio_gpio_init(pio, XIOT_DATA+1);
    pio_gpio_init(pio, XIOT_DATA+2);
    pio_gpio_init(pio, XIOT_DATA+3);
    // Set the pin direction to input at the PIO
    pio_sm_set_consecutive_pindirs(pio, sm, XIOT_DATA, XIOT_DATAWIDTH, true);
    pio_sm_set_consecutive_pindirs(pio, sm, XIOT_ACK, 1, true);

    // Load our configuration, and jump to the start of the program
    pio_add_program(pio, pio_program_t *(XIOTsm0_program))
    pio_sm_init(pio, 0, 0, &cfg_sm0);
    pio_add_program(pio, pio_program_t *(XIOTsm13_program))
    pio_sm_init(pio, 1, XIOTsm13_wrap_target, &cfg_sm1);
    pio_sm_init(pio, 3, XIOTsm13_wrap_target, &cfg_sm3);

   // Set the state machines running (1,3 at WFI, then SM0 controller)
    pio_sm_set_enabled(pio, 1, true);
    pio_sm_set_enabled(pio, 3, true);
    pio_sm_set_enabled(pio, 0, true);
}
%}

% python {
# 1 x controller state machine

## 3x target state machines
sm0 = rp2.StateMachine(0, XIOTsm0,  set_base=Pin(XIOT_DATA), out_base=Pin(XIOT_DATA), in_base=Pin(XIOT_DATA), sideset_base=XIOT_ACK, jmp_pin=XIOT_RQ1)
sm1 = rp2.StateMachine(1, XIOTsm13, set_base=Pin(XIOT_DATA), out_base=Pin(XIOT_DATA), in_base=Pin(XIOT_DATA), sideset_base=XIOT_ACK, jmp_pin=XIOT_DIR)
sm3 = rp2.StateMachine(3, XIOTsm13, set_base=Pin(XIOT_DATA), out_base=Pin(XIOT_DATA), in_base=Pin(XIOT_DATA), sideset_base=XIOT_ACK, jmp_pin=XIOT_DIR)
sm0 = rp2.StateMachine(0, XIOTsm02, set_base=Pin(XIOT_DATA), out_base=Pin(XIOT_DATA), in_base=Pin(XIOT_DATA), sideset_base=XIOT_ACK, jmp_pin=XIOT_RQ1)
sm1 = rp2.StateMachine(1, XIOTsm13, out_base=Pin(XIOT_DATA), sideset_base=XIOT_ACK)
sm3 = rp2.StateMachine(3, XIOTsm13, out_base=Pin(XIOT_DATA), sideset_base=XIOT_ACK)

# global copy of virtual channel flags
xiot_vcflags = 0b1111

verbose = False

XIOT_MODE.value(0)

# Function to get target FIFO status
#From controller perspective:
#   FIFO_status[3:0] = { tx1, rx1, tx0, rx0}
#   Controller interprets as (tx1 empty, rx1_full, tx0 empty, rx0_full)
# so we need (rx)
#    fifo_status = rx1_not_empty << 3 | tx1_full << 2 | rx0_not_empty << 1 | tx0_full
def get_xiot_fifo_status():
    fifo_flags = 0b1111
    if sm0.rx_fifo() <= 2: # RX channels share SM0
        fifo_flags = fifo_flags & 0b0101
    if sm1.tx_fifo() > 0:
        fifo_flags = fifo_flags & 0b1110 #0b1110
    if sm3.tx_fifo() > 0:
        fifo_flags = fifo_flags & 0b1011 #0b1011
    return fifo_flags

# Function to update target FIFO status
def update_xiot_fifo_status():
    # global copy of virtual channel flags
    global xiot_vcflags
    xiot_vcflags = get_xiot_fifo_status()
    sm0.put(xiot_vcflags)
    return 

def xiot_xfer_check():
    return(sm0.rx_fifo() > 0)

def xiot_xfer_report(rx12):
    chan = (rx12 & 0x200) != 0
    read = (rx12 & 0x100) != 0
    char = rx12 & 0xff
    print(f"XIOT C:{chan}, R:{read}, D:{char:02x}")
    return(rx12)

# XIOT tx0->rx0 - SM1 FIFO/SM
def xiot_tx0(txbyte):  # host channel 0 tx
    global xiot_vcflags
    if txbyte == 0x5d: # remap ']'
      txbyte = 0x1b # to ESC
    sm1.put(txbyte<<24)
    return(xiot_vcflags)

# XIOT tx1->rx1 - SM3 FIFO/SM
def xiot_tx1(txbyte):  # host channel 1 tx
    global xiot_vcflags
    sm3.put(txbyte<<24)
    return(xiot_vcflags)

def fifo_stats():
    print(sm0.tx_fifo(), sm1.tx_fifo(),  sm3.tx_fifo(),
          sm0.rx_fifo(), sm1.rx_fifo(),  sm3.rx_fifo(), end="\n")

# start both output state machines
sm1.active(1)
sm3.active(1)
sm0.put(0b1111) # all channels inactive
# finally start main read/control state machine
sm0.active(1)

get_xiot_fifo_status()
update_xiot_fifo_status()

#dp = os.dupterm(None) # disassociate REPL from terminal in/out
#micropython.kbd_intr(-1)

# Loop indefinitely
while True:
  update_xiot_fifo_status() # update channel flags
  # poll input RX FIFO
  if sm0.rx_fifo() > 0 :
    rx=sm0.get()
    chan1 = ((rx & 0x200) != 0)
    read = ((rx & 0x100) == 0)
    data = (rx & 0xff)
    if (verbose):
